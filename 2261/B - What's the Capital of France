#include <bits/stdc++.h>
using namespace std;
#define int long long
#define loop(i,j,k) for(int i = (j); i < (k); i++)
#define rloop(i,j,k) for(int i = (j); i>= (k); i--)
#define pb push_back
 
void sol(){
    int n;
    cin>>n;
    vector<int> a(n);
    int ans = 0;
    loop(i,0,n) {
        cin>>a[i];
    }
    if(n==1) {
        cout<<a[0]<<"
";
        return;
    }
    for(int p=pow(2,30) ;p>0; p /= 2) {
        int cnt = 0;
        loop(i,0,n) {
            if(a[i] & p)
                cnt++;
        }
        if(cnt == 0)
            continue;
        if(cnt == n) {
            ans |= p;
            loop(i,0,n) {
                a[i] ^= p;
            }
        }
        else {
            ans |= (2*p -1);
            break;
        }
    }
    cout<<ans<<"
";
}
 
signed main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while(t--)
        sol();
        return 0;
}